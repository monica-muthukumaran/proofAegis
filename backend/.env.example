# Local production-like configuration. Copy to backend/.env and replace every
# placeholder locally. Never commit the resulting .env file.
USE_MOCK_DATA=false
AUTH_REQUIRED=true
ALLOWED_ORIGINS=http://localhost:5173
GEMINI_API_KEY=replace-with-your-Gemini-API-key
GOOGLE_CLOUD_PROJECT=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
# Put the complete one-line JSON content of the Firebase service-account key here.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id"}

# --- Cloud Storage for uploaded case documents (P0 ingestion) ---
# Accepts "gs://name" or a bare bucket name. Falls back to
# FIREBASE_STORAGE_BUCKET above when unset.
STORAGE_BUCKET=gs://your-firebase-project-id.firebasestorage.app
# auto = use Cloud Storage when a bucket AND credentials are both present,
# otherwise write to LOCAL_STORAGE_DIR. Set to "local" to force on-disk
# storage (the test suite pins this so a machine with real credentials can
# never have a test run reach a live bucket).
STORAGE_BACKEND=auto
MAX_UPLOAD_SIZE_MB=15
# Per-request cap only. A CASE has no document limit.
MAX_FILES_PER_REQUEST=20
SIGNED_URL_TTL_MINUTES=15

# --- Workspace scoping ---
# Single-workspace enforcement: every case record and Storage path is scoped
# to this id unless a verified token carries a workspace_id custom claim.
DEFAULT_WORKSPACE_ID=demo-workspace

# --- OCR for scanned documents (services/ingestion_service.py) ---
# Needs the Tesseract binary on PATH and TESSDATA_PREFIX pointing at its
# language data. Off by default so a server without Tesseract reports that
# clearly instead of failing every scanned upload with a confusing error.
# OCR is only ever a FALLBACK: a PDF that has a real text layer is never
# OCR'd, because embedded text is exact and OCR output is inference.
OCR_ENABLED=false
OCR_DPI=300

# --- Email intake (services/email_intake.py) ---
# Polls an IMAP mailbox and turns PDF attachments into cases. Inert until
# ENABLED is true AND host/user/password are set AND at least one sender is
# allowed — an inbox that accepts documents from anyone is an open door into
# an approval queue. Messages are marked \Seen, never deleted.
EMAIL_INTAKE_ENABLED=false
EMAIL_INTAKE_HOST=imap.gmail.com
EMAIL_INTAKE_PORT=993
EMAIL_INTAKE_USER=ap-invoices@yourcompany.com
EMAIL_INTAKE_PASSWORD=an-app-password-not-your-account-password
EMAIL_INTAKE_FOLDER=INBOX
EMAIL_INTAKE_BATCH_SIZE=20
# Comma-separated. An entry is a full address or a domain (@vendor.com).
EMAIL_INTAKE_ALLOWED_SENDERS=billing@vendor.com,@trusted-supplier.com

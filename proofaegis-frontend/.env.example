# Copy to proofaegis-frontend/.env.production before building for Firebase Hosting.
# These Firebase web-app values are public configuration, but do not put server
# secrets, a Gemini key, or a service-account key in this file.
# Leave blank when deploying through the Firebase Hosting /api Cloud Run rewrite.
# Set to true ONLY to build a demo bundle that runs with no backend.
# Leave false/unset in production: the app must show real failures, not
# silently substitute sample data.
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
